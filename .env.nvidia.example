# NVIDIA Kit/USD/Isaac MCP cloud mode. Copy values into an untracked .env.
# Generate the key at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Optional overrides for the four local Streamable HTTP endpoints.
NVIDIA_OMNI_UI_MCP_URL=http://127.0.0.1:9901/mcp
NVIDIA_KIT_MCP_URL=http://127.0.0.1:9902/mcp
NVIDIA_USD_CODE_MCP_URL=http://127.0.0.1:9903/mcp
NVIDIA_ISAAC_SIM_MCP_URL=http://127.0.0.1:9904/mcp

# Disable NVIDIA MCP usage analytics when supported by the server.
KIT_MCP_DISABLE_USAGE_LOGGING=true
OMNI_UI_DISABLE_USAGE_LOGGING=true
